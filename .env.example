# ---------------------------------------------------------------------------
# Keep Track — environment configuration
# Copy this file to .env and fill in real values before running docker
# compose. Run scripts/generate-secrets.sh to generate the two REQUIRED
# security keys below.
# ---------------------------------------------------------------------------

# --- Database -----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=keep_track
POSTGRES_USER=keep_track
POSTGRES_PASSWORD=                      # REQUIRED: set a strong password
DATABASE_URL=postgresql://keep_track:change-me@postgres:5432/keep_track  # keep the user/password in sync with the lines above

# --- Backend (FastAPI) ----------------------------------------------------------
BACKEND_PORT=8000

# --- Security — REQUIRED: generate these before first run -----------------------
# Refused at startup if missing/too short/a known placeholder — see
# backend/main.py::_validate_security_config and docs/security.md.
JWT_SECRET=                             # Min 32 chars: openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480                  # 8 hours, per the authentication security requirements
MFA_ENCRYPTION_KEY=                     # Fernet key: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ISSUER=KeepTrack

# --- Superadmin recovery account (optional but recommended) ---------------------
# Bootstrapped on first backend startup, independent of the setup wizard —
# the only account recovery path if every Admin gets locked out. Leave all
# three unset to skip creating one.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=                    # Set a very strong password

# --- Frontend (React) -----------------------------------------------------------
FRONTEND_PORT=3000
# Base URL the *dev* frontend uses to reach the backend API directly (Vite
# dev server has no reverse proxy). Not used by the production build — that
# always calls same-origin /api/*, proxied to the backend by nginx.conf. See
# docs/decisions-log.md.
VITE_API_BASE_URL=http://localhost:8000

# --- CORS -------------------------------------------------------------------------
# Comma-separated origin(s) the backend accepts cross-origin requests from.
# In production behind the bundled nginx.conf this is same-origin and
# largely academic, but still set it to your real domain/IP; never "*" (that
# combination with cookies/credentials is rejected by browsers anyway, and
# broader than any deployment needs).
CORS_ORIGINS=http://localhost,https://yourdomain.com

# --- AI Provider (optional — configure per-provider in Settings after first run) -
# Anthropic is the default provider; other providers (OpenAI, Gemini, Grok,
# Mistral, Cohere, Ollama, Custom) are configured entirely in
# Settings -> AI & Extraction, including their own API keys. This is only a
# fallback used when no key is configured in the database for the active
# provider — see docs/architecture.md.
ANTHROPIC_API_KEY=                      # Optional fallback key
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Rate limiting ------------------------------------------------------------------
# How many times per hour per user the "Test connection" button
# (Settings -> AI & Extraction) can be used.
AI_TEST_RATE_LIMIT=60

# --- Watched folder (SMB/NFS) --------------------------------------------------
# Path the folder-watcher service monitors for new invoice PDFs, under the
# single storage volume (see docker-compose.prod.yml's keeptrack_storage).
WATCHED_FOLDER_PATH=/data/watched

# --- Financial year defaults ---------------------------------------------------
# Fallback only, used if the financial_year_start_month row in the settings
# table is somehow missing/unset. The real, runtime-editable value lives in
# Settings (or the setup wizard) once the app is installed.
DEFAULT_FINANCIAL_YEAR_START_MONTH=9

# --- Notifications ---------------------------------------------------------------
UNCONFIRMED_INVOICE_ALERT_DAYS=5

# --- Reverse proxy (Traefik) ----------------------------------------------------
# Traefik is bundled in docker-compose.prod.yml and handles all incoming
# traffic — no separate reverse proxy install needed. See docs/deployment.md.
KEEPTRACK_HTTP_PORT=80                  # External HTTP port (change if 80 is already in use)
KEEPTRACK_HTTPS_PORT=443                # External HTTPS port (change if 443 is already in use)
KEEPTRACK_DOMAIN=localhost              # Your domain name (used for SSL configuration)
