# ---------------------------------------------------------------------------
# Keep Track — environment configuration
# Copy this file to .env and fill in real values before running docker-compose.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=keep_track
POSTGRES_USER=keep_track
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://keep_track:change-me@postgres:5432/keep_track

# --- Backend (FastAPI) -------------------------------------------------------
BACKEND_PORT=8000
# Secret used to sign JWT auth tokens — generate a long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# 8 hours, per the authentication security requirements.
JWT_EXPIRY_MINUTES=480

# --- Authentication / MFA ----------------------------------------------------
TOTP_ISSUER=Keep Track
# Fernet key encrypting users.mfa_secret at rest — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# The Superadmin is a recovery-only account (see docs/user-roles.md) bootstrapped
# from these variables on first backend startup, independent of the setup wizard.
# Leave unset to skip creating one.
SUPERADMIN_USERNAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Frontend (React) --------------------------------------------------------
FRONTEND_PORT=3000
# Base URL the frontend uses to reach the backend API.
VITE_API_BASE_URL=http://localhost:8000

# --- Anthropic API ------------------------------------------------------------
# Used for invoice data extraction and AI-generated report summaries.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- File storage -------------------------------------------------------------
# Local filesystem paths (inside the backend container) for invoice PDFs.
INVOICE_STORAGE_PATH=/data/invoices
SIGNED_INVOICE_STORAGE_PATH=/data/invoices/signed

# --- Watched folder (SMB/NFS) --------------------------------------------------
# Path the watched-folder-watcher service monitors for new invoice PDFs.
# Mount your SMB/NFS share to this path in docker-compose.
WATCHED_FOLDER_PATH=/data/watched

# --- Financial year defaults ---------------------------------------------------
DEFAULT_FINANCIAL_YEAR_START_MONTH=9
DEFAULT_FINANCIAL_YEAR_END_MONTH=8

# --- Notifications ---------------------------------------------------------------
UNCONFIRMED_INVOICE_ALERT_DAYS=5
